# Copia este ficheiro para .env e preenche a tua chave:
#   cp .env.example .env
# O .env está no .gitignore — a chave NUNCA vai para o repositório.

# Chave da RapidAPI (obrigatória para o coletor real).
# A mesma chave costuma servir para todas as APIs que subscreveres na tua
# conta RapidAPI — só muda o host/endpoint consoante a rede social.
RAPIDAPI_KEY=coloca_aqui_a_tua_chave

# TikTok — validado e a funcionar (tiktok-scraper7)
RAPIDAPI_HOST=tiktok-scraper7.p.rapidapi.com
RAPIDAPI_ENDPOINT=/feed/search

# Instagram — ajusta ao endpoint que subscreveres no RapidAPI (ver README)
RAPIDAPI_HOST_INSTAGRAM=instagram-scraper-api2.p.rapidapi.com
RAPIDAPI_ENDPOINT_INSTAGRAM=/v1/hashtag

# Score mínimo para um vídeo ser marcado como candidato
SCORE_THRESHOLD=500
# Peso da taxa de engagement na fórmula do score
PESO_ENGAGEMENT=10

# Caminhos (opcional — por omissão ficam na pasta do projeto)
# DB_PATH=/caminho/para/radar_viral.db
# DOWNLOADS_DIR=/caminho/para/downloads

# Dashboard
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
